{
  "properties": {
    "displayName": "Allowed VM SKUs - burstable/free-tier only",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Denies creation of virtual machines outside of an approved list of burstable, free-tier-eligible SKUs. Keeps lab compute costs near zero and prevents an accidental deployment of an expensive VM size.",
    "metadata": {
      "category": "Custom Policy",      
    },
    "version": "1.0.0",
    "parameters": {
      "listOfAllowedSKUs": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed VM SKUs",
          "description": "The list of VM sizes allowed for deployment.",
          "strongType": "vmSKUs"
        },
        "defaultValue": [
          "Standard_B1s",
          "Standard_B1ms",
          "Standard_B2s"
        ]
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Deny blocks non-compliant deployments; Audit flags them without blocking."
        },
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/sku.name",
            "notIn": "[parameters('listOfAllowedSKUs')]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    },
    "versions": [
      "1.0.0"
    ]  
  }
}
